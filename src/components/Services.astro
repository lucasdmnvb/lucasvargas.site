---
import { seoServices, testimonials } from '../data/cv';
---

<section id="services" class="section bg-surface" aria-labelledby="services-title">
  <div class="container mx-auto">
    <div class="max-w-3xl mx-auto text-center mb-16">
      <span class="badge mb-4">Servicios SEO</span>
      <h2 id="services-title" class="section-title">Servicios de consultoría SEO data-driven</h2>
      <p class="section-subtitle">Estrategias de crecimiento orgánico basadas en datos, automatización con IA y ejecución medible</p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
      {seoServices.map((service, index) => (
        <article class="card group relative overflow-hidden" style="animation-delay: {index * 100}ms">
          <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-accent to-primary/50 opacity-0 group-hover:opacity-100 transition-opacity duration-300" aria-hidden="true"></div>

          <h3 class="text-xl font-semibold text-primary mb-3">{service.title}</h3>
          <p class="text-text-muted text-sm mb-5">{service.description}</p>

          <div class="text-2xl font-bold text-accent mb-5">{service.price}</div>

          <ul class="space-y-2 mb-6" role="list">
            {service.features.map(feature => (
              <li class="flex items-start gap-2 text-sm text-text">
                <svg class="w-4 h-4 text-accent flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span>{feature}</span>
              </li>
            ))}
          </ul>

          <a href="#contact" class="btn-secondary w-full text-center group-hover:bg-primary group-hover:text-white group-hover:border-primary">
            Solicitar propuesta
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </article>
      ))}
    </div>

    <div class="bg-primary rounded-2xl p-8 md:p-12 text-center relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-r from-accent/10 to-primary/20" aria-hidden="true"></div>
      <div class="absolute top-0 right-0 w-72 h-72 bg-accent/10 rounded-full blur-3xl" aria-hidden="true"></div>
      <div class="relative z-10">
        <h3 class="text-2xl md:text-3xl font-bold text-white mb-4">¿No ves lo que necesitas?</h3>
        <p class="text-slate-300 mb-8 max-w-2xl mx-auto">Diseño soluciones a medida: automatizaciones SEO custom, migraciones complejas, programmatic SEO, internacionalización, o retainer mensual adaptado a tu equipo.</p>
        <a href="#contact" class="btn bg-white text-primary hover:bg-slate-100 px-8 py-3">
          Hablemos de tu proyecto
        </a>
      </div>
    </div>

    {testimonials.length > 0 && (
      <div class="mt-16">
        <h3 class="text-2xl font-bold text-primary text-center mb-10">Lo que dicen mis clientes</h3>
        <div class="grid md:grid-cols-2 gap-6 max-w-4xl mx-auto">
          {testimonials.map((testimonial, index) => (
            <blockquote class="card relative" style="animation-delay: {index * 100}ms">
              <div class="absolute top-4 right-4 text-accent/20">
                <svg class="w-12 h-12" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.423.94-3.995 3.667-3.995 5.848v7.001h-5.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.423.94-3.995 3.667-3.995 5.848v7.001h-5.983z"/></svg>
              </div>
              <p class="text-text mb-6 relative z-10">"{testimonial.content}"</p>
              <footer class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-full bg-accent-light flex items-center justify-center">
                  <span class="text-accent font-medium text-sm">{testimonial.name.charAt(0)}</span>
                </div>
                <div>
                  <p class="font-medium text-primary text-sm">{testimonial.name}</p>
                  <p class="text-text-muted text-xs">{testimonial.role}, {testimonial.company}</p>
                </div>
              </footer>
            </blockquote>
          ))}
        </div>
      </div>
    )}
  </div>
</section>