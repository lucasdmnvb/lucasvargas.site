---
// Interactive Analytics & Product Lab component
// Demonstrates cohort retention/CLV modeling and Paid vs. Organic cannibalization diagnostics
---

<section id="laboratorio" class="border-y border-line bg-surface-subtle/60 py-16 sm:py-24">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <div class="mb-10 flex flex-col justify-between gap-6 md:flex-row md:items-end">
      <div class="max-w-2xl">
        <span class="mb-3 inline-flex items-center gap-2 rounded-full border border-line bg-surface px-3 py-1 font-mono text-xs font-medium text-ink-muted">
          <span class="h-1.5 w-1.5 rounded-full bg-signal"></span>
          Laboratorio Interactivo · Modelos Ilustrativos
        </span>
        <h2 class="text-2xl font-bold tracking-tight text-ink sm:text-3xl">
          De la métrica cruda a la simulación de negocio
        </h2>
        <p class="mt-2.5 text-sm leading-relaxed text-ink-muted sm:text-base">
          Dos sandboxes interactivos construidos con parámetros ilustrativos para mostrar cómo modelo retención por cohortes, CLV y solapamiento Paid/Organic antes de recomendar cambios de producto o presupuesto.
        </p>
      </div>

      <div
        class="inline-flex rounded-xl border border-line bg-surface p-1 shadow-xs"
        role="tablist"
        aria-label="Seleccionar simulador"
      >
        <button
          id="tab-btn-cohort"
          type="button"
          role="tab"
          aria-selected="true"
          class="lab-tab-btn rounded-lg bg-ink px-3.5 py-2 text-xs font-semibold text-white transition-colors sm:text-sm"
          data-tab="cohort"
        >
          Cohortes, Churn & CLV
        </button>
        <button
          id="tab-btn-cannibal"
          type="button"
          role="tab"
          aria-selected="false"
          class="lab-tab-btn rounded-lg px-3.5 py-2 text-xs font-semibold text-ink-muted transition-colors hover:text-ink sm:text-sm"
          data-tab="cannibal"
        >
          Canibalización SEM / SEO
        </button>
      </div>
    </div>

    <!-- Panel 1: Cohort Retention & CLV -->
    <div
      id="lab-panel-cohort"
      class="lab-panel grid gap-6 rounded-2xl border border-line bg-surface p-6 shadow-xs lg:grid-cols-12 lg:p-8"
    >
      <div class="flex flex-col justify-between gap-6 lg:col-span-5">
        <div class="space-y-5">
          <div>
            <div class="mb-2 flex items-center justify-between text-xs font-medium">
              <label for="input-churn" class="text-ink">Churn mensual base</label>
              <span id="val-churn" class="font-mono font-semibold text-ink">6.5%</span>
            </div>
            <input
              id="input-churn"
              type="range"
              min="1.5"
              max="18"
              step="0.5"
              value="6.5"
              class="lab-slider"
            />
            <p class="mt-1 text-[11px] text-ink-soft">Porcentaje de usuarios/pólizas que abandonan cada mes.</p>
          </div>

          <div>
            <div class="mb-2 flex items-center justify-between text-xs font-medium">
              <label for="input-arpu" class="text-ink">Margen mensual promedio (CLP)</label>
              <span id="val-arpu" class="font-mono font-semibold text-ink">$12.000</span>
            </div>
            <input
              id="input-arpu"
              type="range"
              min="4000"
              max="35000"
              step="1000"
              value="12000"
              class="lab-slider"
            />
            <p class="mt-1 text-[11px] text-ink-soft">Contribución mensual estimada por cliente activo.</p>
          </div>

          <div>
            <div class="mb-2 flex items-center justify-between text-xs font-medium">
              <label for="input-lift" class="text-ink">Reducción de churn vía mejora de producto</label>
              <span id="val-lift" class="font-mono font-semibold text-signal">-25%</span>
            </div>
            <input
              id="input-lift"
              type="range"
              min="5"
              max="50"
              step="5"
              value="25"
              class="lab-slider"
            />
            <p class="mt-1 text-[11px] text-ink-soft">Efecto de mejoras en onboarding, siniestros o segmentación.</p>
          </div>
        </div>

        <div class="rounded-xl border border-line bg-surface-subtle p-4">
          <button
            id="toggle-sql-btn"
            type="button"
            class="flex w-full items-center justify-between text-left text-xs font-semibold text-ink"
          >
            <span class="font-mono">Ver lógica SQL / DAX de cohortes</span>
            <span id="toggle-sql-icon" class="font-mono text-ink-muted">+</span>
          </button>
          <pre
            id="cohort-sql-box"
            class="mt-3 hidden overflow-x-auto rounded-lg bg-ink p-3 font-mono text-[11px] leading-relaxed text-neutral-200"
          ><code>-- Retención y CLV simplificado por cohorte
SELECT
  cohort_month,
  month_n,
  COUNT(DISTINCT user_id) AS activos,
  ROUND(100.0 * COUNT(DISTINCT user_id) / cohort_size, 1) AS retencion_pct
FROM user_monthly_activity
GROUP BY 1, 2;</code></pre>
        </div>
      </div>

      <div class="flex flex-col justify-between gap-6 lg:col-span-7">
        <div class="grid gap-3 sm:grid-cols-3">
          <div class="rounded-xl border border-line bg-canvas p-4">
            <span class="block font-mono text-[11px] uppercase tracking-wider text-ink-soft">CLV Base</span>
            <span id="out-clv-base" class="mt-1 block font-mono text-xl font-bold text-ink">$184.615</span>
            <span id="out-life-base" class="mt-0.5 block text-xs text-ink-muted">15.4 meses de vida media</span>
          </div>
          <div class="rounded-xl border border-signal/30 bg-signal-soft/50 p-4">
            <span class="block font-mono text-[11px] uppercase tracking-wider text-signal">CLV Optimizado</span>
            <span id="out-clv-new" class="mt-1 block font-mono text-xl font-bold text-signal">$246.154</span>
            <span id="out-life-new" class="mt-0.5 block text-xs text-signal/80">20.5 meses de vida media</span>
          </div>
          <div class="rounded-xl border border-accent/25 bg-accent-soft/60 p-4">
            <span class="block font-mono text-[11px] uppercase tracking-wider text-accent">Impacto / 1.000 clientes</span>
            <span id="out-delta-cohort" class="mt-1 block font-mono text-xl font-bold text-accent">+$61.5M</span>
            <span class="mt-0.5 block text-xs text-ink-muted">Valor incremental en ciclo de vida</span>
          </div>
        </div>

        <div class="rounded-xl border border-line bg-canvas p-4 sm:p-5">
          <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
            <span class="text-xs font-semibold text-ink">Curva de supervivencia de cohorte (Mes 0 → Mes 12)</span>
            <div class="flex items-center gap-4 text-[11px] font-medium">
              <span class="flex items-center gap-1.5 text-ink-muted">
                <span class="inline-block h-2 w-2 rounded-full bg-ink-soft"></span> Base
              </span>
              <span class="flex items-center gap-1.5 text-signal">
                <span class="inline-block h-2 w-2 rounded-full bg-signal"></span> Con mejora de retención
              </span>
            </div>
          </div>

          <svg
            id="cohort-svg"
            viewBox="0 0 560 210"
            class="h-48 w-full overflow-visible"
            role="img"
            aria-label="Gráfico comparativo de supervivencia de cohorte a 12 meses"
          >
            <!-- Grid lines -->
            <g stroke="#e4e4df" stroke-dasharray="3 3" stroke-width="1">
              <line x1="40" y1="20" x2="540" y2="20" />
              <line x1="40" y1="60" x2="540" y2="60" />
              <line x1="40" y1="100" x2="540" y2="100" />
              <line x1="40" y1="140" x2="540" y2="140" />
              <line x1="40" y1="180" x2="540" y2="180" />
            </g>
            <!-- Y axis labels -->
            <g fill="#7b8291" font-family="JetBrains Mono, monospace" font-size="10" text-anchor="end">
              <text x="32" y="23">100%</text>
              <text x="32" y="63">75%</text>
              <text x="32" y="103">50%</text>
              <text x="32" y="143">25%</text>
              <text x="32" y="183">0%</text>
            </g>
            <!-- X axis labels -->
            <g fill="#7b8291" font-family="JetBrains Mono, monospace" font-size="10" text-anchor="middle">
              <text x="40" y="198">M0</text>
              <text x="123" y="198">M2</text>
              <text x="206" y="198">M4</text>
              <text x="290" y="198">M6</text>
              <text x="373" y="198">M8</text>
              <text x="456" y="198">M10</text>
              <text x="540" y="198">M12</text>
            </g>

            <path id="cohort-area-new" d="" fill="rgba(4, 120, 87, 0.08)" />
            <path id="cohort-line-base" d="" fill="none" stroke="#7b8291" stroke-width="2.2" stroke-dasharray="5 4" />
            <path id="cohort-line-new" d="" fill="none" stroke="#047857" stroke-width="2.8" />
            <g id="cohort-points"></g>
          </svg>
        </div>
      </div>
    </div>

    <!-- Panel 2: Paid vs Organic Cannibalization -->
    <div
      id="lab-panel-cannibal"
      class="lab-panel hidden grid gap-6 rounded-2xl border border-line bg-surface p-6 shadow-xs lg:grid-cols-12 lg:p-8"
    >
      <div class="flex flex-col justify-between gap-6 lg:col-span-5">
        <div class="space-y-5">
          <div>
            <div class="mb-2 flex items-center justify-between text-xs font-medium">
              <label for="input-sem-spend" class="text-ink">Inversión mensual SEM en términos con ranking Top 3</label>
              <span id="val-sem-spend" class="font-mono font-semibold text-ink">$10.000.000</span>
            </div>
            <input
              id="input-sem-spend"
              type="range"
              min="2000000"
              max="25000000"
              step="500000"
              value="10000000"
              class="lab-slider"
            />
            <p class="mt-1 text-[11px] text-ink-soft">Gasto en pauta de búsqueda donde el sitio ya lidera en SEO.</p>
          </div>

          <div>
            <div class="mb-2 flex items-center justify-between text-xs font-medium">
              <label for="input-seo-capture" class="text-ink">Tasa de absorción orgánica estimada sin pauta</label>
              <span id="val-seo-capture" class="font-mono font-semibold text-signal">75%</span>
            </div>
            <input
              id="input-seo-capture"
              type="range"
              min="30"
              max="95"
              step="5"
              value="75"
              class="lab-slider"
            />
            <p class="mt-1 text-[11px] text-ink-soft">Porcentaje de clics retenidos vía SEO al pausar pujas redundantes.</p>
          </div>

          <div>
            <div class="mb-2 flex items-center justify-between text-xs font-medium">
              <label for="input-defense-keep" class="text-ink">Reserva defensiva por presión competitiva</label>
              <span id="val-defense-keep" class="font-mono font-semibold text-ink">15%</span>
            </div>
            <input
              id="input-defense-keep"
              type="range"
              min="0"
              max="40"
              step="5"
              value="15"
              class="lab-slider"
            />
            <p class="mt-1 text-[11px] text-ink-soft">Presupuesto mantenido en queries donde competidores pujan fuerte.</p>
          </div>
        </div>

        <div class="rounded-xl border border-line bg-surface-subtle p-4 text-xs leading-relaxed text-ink-muted">
          <strong class="text-ink">Criterio diagnóstico:</strong> cruzar Search Console (posición media e impresiones), Google Ads (costo por término) y GA4 (conversión asistida) antes de cortar pujas a ciegas.
        </div>
      </div>

      <div class="flex flex-col justify-between gap-6 lg:col-span-7">
        <div class="grid gap-3 sm:grid-cols-3">
          <div class="rounded-xl border border-signal/30 bg-signal-soft/50 p-4">
            <span class="block font-mono text-[11px] uppercase tracking-wider text-signal">Ahorro mensual neto</span>
            <span id="out-cannibal-month" class="mt-1 block font-mono text-xl font-bold text-signal">$6.375.000</span>
            <span class="mt-0.5 block text-xs text-signal/80">Presupuesto recuperable</span>
          </div>
          <div class="rounded-xl border border-accent/25 bg-accent-soft/60 p-4">
            <span class="block font-mono text-[11px] uppercase tracking-wider text-accent">Proyección anual</span>
            <span id="out-cannibal-year" class="mt-1 block font-mono text-xl font-bold text-accent">$76.5M</span>
            <span class="mt-0.5 block text-xs text-ink-muted">Reinversión eficiente</span>
          </div>
          <div class="rounded-xl border border-line bg-canvas p-4">
            <span class="block font-mono text-[11px] uppercase tracking-wider text-ink-soft">Eficiencia liberada</span>
            <span id="out-cannibal-pct" class="mt-1 block font-mono text-xl font-bold text-ink">63.8%</span>
            <span class="mt-0.5 block text-xs text-ink-muted">Sobre el gasto solapado</span>
          </div>
        </div>

        <div class="rounded-xl border border-line bg-canvas p-5">
          <p class="mb-4 text-xs font-semibold text-ink">Distribución del presupuesto analizado</p>

          <div class="space-y-4">
            <div>
              <div class="mb-1.5 flex justify-between text-xs">
                <span class="text-ink-muted">Gasto actual (sin auditoría Paid/Organic)</span>
                <span id="bar-label-current" class="font-mono font-medium text-ink">$10.000.000</span>
              </div>
              <div class="h-3.5 w-full overflow-hidden rounded-full bg-line">
                <div class="h-full w-full rounded-full bg-ink-soft"></div>
              </div>
            </div>

            <div>
              <div class="mb-1.5 flex justify-between text-xs">
                <span class="text-ink-muted">Gasto óptimo post-diagnóstico (defensa + incremental)</span>
                <span id="bar-label-opt" class="font-mono font-medium text-ink">$3.625.000</span>
              </div>
              <div class="h-3.5 w-full overflow-hidden rounded-full bg-signal-soft">
                <div id="bar-fill-opt" class="h-full rounded-full bg-accent transition-all duration-300" style="width: 36%"></div>
              </div>
            </div>

            <div>
              <div class="mb-1.5 flex justify-between text-xs">
                <span class="font-medium text-signal">Presupuesto liberado por absorción SEO</span>
                <span id="bar-label-saved" class="font-mono font-semibold text-signal">$6.375.000</span>
              </div>
              <div class="h-3.5 w-full overflow-hidden rounded-full bg-line/60">
                <div id="bar-fill-saved" class="h-full rounded-full bg-signal transition-all duration-300" style="width: 64%"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const formatCLP = (val: number) =>
    '$' + Math.round(val).toLocaleString('es-CL');

  const formatCompactCLP = (val: number) => {
    const abs = Math.abs(val);
    if (abs >= 1_000_000) {
      return '$' + (val / 1_000_000).toFixed(1) + 'M';
    }
    return formatCLP(val);
  };

  // Tab switching
  const tabButtons = document.querySelectorAll<HTMLButtonElement>('.lab-tab-btn');
  const cohortPanel = document.getElementById('lab-panel-cohort');
  const cannibalPanel = document.getElementById('lab-panel-cannibal');

  tabButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.dataset.tab;
      tabButtons.forEach((b) => {
        const active = b.dataset.tab === target;
        b.setAttribute('aria-selected', String(active));
        b.classList.toggle('bg-ink', active);
        b.classList.toggle('text-white', active);
        b.classList.toggle('text-ink-muted', !active);
        b.classList.toggle('hover:text-ink', !active);
      });
      if (cohortPanel && cannibalPanel) {
        cohortPanel.classList.toggle('hidden', target !== 'cohort');
        cannibalPanel.classList.toggle('hidden', target !== 'cannibal');
      }
    });
  });

  // SQL toggle
  const sqlBtn = document.getElementById('toggle-sql-btn');
  const sqlBox = document.getElementById('cohort-sql-box');
  const sqlIcon = document.getElementById('toggle-sql-icon');
  if (sqlBtn && sqlBox && sqlIcon) {
    sqlBtn.addEventListener('click', () => {
      const isHidden = sqlBox.classList.contains('hidden');
      sqlBox.classList.toggle('hidden');
      sqlIcon.textContent = isHidden ? '−' : '+';
    });
  }

  // Cohort simulator logic
  const inputChurn = document.getElementById('input-churn') as HTMLInputElement | null;
  const inputArpu = document.getElementById('input-arpu') as HTMLInputElement | null;
  const inputLift = document.getElementById('input-lift') as HTMLInputElement | null;

  const updateCohortSim = () => {
    if (!inputChurn || !inputArpu || !inputLift) return;
    const churnPct = parseFloat(inputChurn.value);
    const arpu = parseFloat(inputArpu.value);
    const liftPct = parseFloat(inputLift.value);

    const churnRate = churnPct / 100;
    const newChurnRate = churnRate * (1 - liftPct / 100);

    const lifeBase = 1 / churnRate;
    const lifeNew = 1 / newChurnRate;
    const clvBase = arpu * lifeBase;
    const clvNew = arpu * lifeNew;
    const delta1k = (clvNew - clvBase) * 1000;

    const setTxt = (id: string, text: string) => {
      const el = document.getElementById(id);
      if (el) el.textContent = text;
    };

    setTxt('val-churn', `${churnPct.toFixed(1)}%`);
    setTxt('val-arpu', formatCLP(arpu));
    setTxt('val-lift', `-${liftPct}%`);
    setTxt('out-clv-base', formatCLP(clvBase));
    setTxt('out-life-base', `${lifeBase.toFixed(1)} meses de vida media`);
    setTxt('out-clv-new', formatCLP(clvNew));
    setTxt('out-life-new', `${lifeNew.toFixed(1)} meses de vida media`);
    setTxt('out-delta-cohort', `+${formatCompactCLP(delta1k)}`);

    // Render SVG curves (M0..M12)
    const xStart = 40;
    const xEnd = 540;
    const yTop = 20;
    const yBottom = 180;
    const height = yBottom - yTop;

    const ptsBase: string[] = [];
    const ptsNew: string[] = [];
    const circles: string[] = [];

    for (let m = 0; m <= 12; m++) {
      const x = xStart + (m / 12) * (xEnd - xStart);
      const survBase = Math.pow(1 - churnRate, m);
      const survNew = Math.pow(1 - newChurnRate, m);
      const yB = yBottom - survBase * height;
      const yN = yBottom - survNew * height;

      ptsBase.push(`${m === 0 ? 'M' : 'L'} ${x.toFixed(1)} ${yB.toFixed(1)}`);
      ptsNew.push(`${m === 0 ? 'M' : 'L'} ${x.toFixed(1)} ${yN.toFixed(1)}`);

      if (m === 12 || m === 6) {
        circles.push(
          `<circle cx="${x.toFixed(1)}" cy="${yN.toFixed(1)}" r="4" fill="#047857" stroke="#ffffff" stroke-width="1.5" />`,
          `<text x="${x.toFixed(1)}" y="${(yN - 9).toFixed(1)}" text-anchor="middle" fill="#047857" font-family="JetBrains Mono, monospace" font-size="10" font-weight="600">${Math.round(survNew * 100)}%</text>`,
          `<circle cx="${x.toFixed(1)}" cy="${yB.toFixed(1)}" r="3.5" fill="#7b8291" stroke="#ffffff" stroke-width="1.5" />`
        );
      }
    }

    const lineBase = document.getElementById('cohort-line-base');
    const lineNew = document.getElementById('cohort-line-new');
    const areaNew = document.getElementById('cohort-area-new');
    const pointsGroup = document.getElementById('cohort-points');

    const newPathStr = ptsNew.join(' ');
    if (lineBase) lineBase.setAttribute('d', ptsBase.join(' '));
    if (lineNew) lineNew.setAttribute('d', newPathStr);
    if (areaNew) areaNew.setAttribute('d', `${newPathStr} L ${xEnd} ${yBottom} L ${xStart} ${yBottom} Z`);
    if (pointsGroup) pointsGroup.innerHTML = circles.join('');
  };

  [inputChurn, inputArpu, inputLift].forEach((el) => {
    el?.addEventListener('input', updateCohortSim);
  });
  updateCohortSim();

  // Cannibalization simulator logic
  const inputSpend = document.getElementById('input-sem-spend') as HTMLInputElement | null;
  const inputCapture = document.getElementById('input-seo-capture') as HTMLInputElement | null;
  const inputDefense = document.getElementById('input-defense-keep') as HTMLInputElement | null;

  const updateCannibalSim = () => {
    if (!inputSpend || !inputCapture || !inputDefense) return;
    const spend = parseFloat(inputSpend.value);
    const captureRate = parseFloat(inputCapture.value) / 100;
    const defenseRate = parseFloat(inputDefense.value) / 100;

    const reduciblePool = spend * (1 - defenseRate);
    const savedMonthly = reduciblePool * captureRate;
    const optimalSpend = spend - savedMonthly;
    const savedPct = (savedMonthly / spend) * 100;

    const setTxt = (id: string, text: string) => {
      const el = document.getElementById(id);
      if (el) el.textContent = text;
    };

    setTxt('val-sem-spend', formatCLP(spend));
    setTxt('val-seo-capture', `${Math.round(captureRate * 100)}%`);
    setTxt('val-defense-keep', `${Math.round(defenseRate * 100)}%`);

    setTxt('out-cannibal-month', formatCLP(savedMonthly));
    setTxt('out-cannibal-year', formatCompactCLP(savedMonthly * 12));
    setTxt('out-cannibal-pct', `${savedPct.toFixed(1)}%`);

    setTxt('bar-label-current', formatCLP(spend));
    setTxt('bar-label-opt', formatCLP(optimalSpend));
    setTxt('bar-label-saved', formatCLP(savedMonthly));

    const fillOpt = document.getElementById('bar-fill-opt');
    const fillSaved = document.getElementById('bar-fill-saved');
    if (fillOpt) fillOpt.style.width = `${Math.max(4, 100 - savedPct)}%`;
    if (fillSaved) fillSaved.style.width = `${Math.min(96, savedPct)}%`;
  };

  [inputSpend, inputCapture, inputDefense].forEach((el) => {
    el?.addEventListener('input', updateCannibalSim);
  });
  updateCannibalSim();
</script>
