---
import { personalInfo } from '../data/cv';
---

<section id="contact" class="section bg-surface" aria-labelledby="contact-title">
  <div class="container mx-auto">
    <div class="max-w-3xl mx-auto text-center mb-16">
      <span class="badge mb-4">Contacto</span>
      <h2 id="contact-title" class="section-title">Trabajemos juntos</h2>
      <p class="section-subtitle">Disponible para consultoría SEO, proyectos de datos, automatización con IA y colaboraciones freelance</p>
    </div>

    <div class="grid md:grid-cols-3 gap-8 max-w-5xl mx-auto">
      <a href={`mailto:${personalInfo.email}`} class="card group text-center p-8 hover:border-accent transition-colors">
        <div class="w-16 h-16 rounded-xl bg-accent-light text-accent flex items-center justify-center mx-auto mb-5 group-hover:scale-105 transition-transform">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-primary mb-2">Email</h3>
        <p class="text-text-muted text-sm mb-4">Respondo en < 24h hábiles</p>
        <p class="font-medium text-primary group-hover:text-accent transition-colors">{personalInfo.email}</p>
      </a>

      <a href={personalInfo.linkedin} target="_blank" rel="noopener noreferrer" class="card group text-center p-8 hover:border-accent transition-colors">
        <div class="w-16 h-16 rounded-xl bg-accent-light text-accent flex items-center justify-center mx-auto mb-5 group-hover:scale-105 transition-transform">
          <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        </div>
        <h3 class="text-lg font-semibold text-primary mb-2">LinkedIn</h3>
        <p class="text-text-muted text-sm mb-4">Conectemos y charlamos</p>
        <p class="font-medium text-primary group-hover:text-accent transition-colors">linkedin.com/in/lucasdvb</p>
      </a>

      <a href={`https://wa.me/56942884574?text=Hola%20Lucas%2C%20vi%20tu%20web%20y%20me%20gustar%C3%ADa%20hablar%20sobre%20...`} target="_blank" rel="noopener noreferrer" class="card group text-center p-8 hover:border-accent transition-colors">
        <div class="w-16 h-16 rounded-xl bg-green-100 text-green-600 flex items-center justify-center mx-auto mb-5 group-hover:scale-105 transition-transform">
          <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.472.099-.174.05-.372-.025-.52-.075-.149-.669-1.611-.916-2.207-.247-.579-.487-.5-.669-.51-.173-.008-.372-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.57-.076 1.814-.503 2.438-1.877.272-.606.318-.907.219-1.047-.085-.117-.219-.247-.372-.373z"/></svg>
        </div>
        <h3 class="text-lg font-semibold text-primary mb-2">WhatsApp</h3>
        <p class="text-text-muted text-sm mb-4">Respuesta rápida</p>
        <p class="font-medium text-primary group-hover:text-accent transition-colors">+56 9 4288 4574</p>
      </a>
    </div>

    <div class="mt-16 text-center">
      <p class="text-text-muted mb-4">O si prefieres agendar una llamada directa:</p>
      <a href={`mailto:${personalInfo.email}?subject=Agendar%20llamada%20-%20lucasvargas.site&body=Hola%20Lucas%2C%0A%0AQuiero%20agendar%20una%20llamada%20de%2015-30%20min%20para%20comentar%20mi%20proyecto%3A%0A%0A-%20Tipo%3A%20%5BSEO%20%2F%20Data%20%2F%20IA%20%2F%20Otro%5D%0A-%20Objetivo%3A%20%5BDescribe%20tu%20objetivo%5D%0A-%20Timing%3A%20%5BCu%C3%A1ndo%20necesitas%20empezar%5D%0A%0AQuedo%20atento%2C`} class="btn-primary inline-flex items-center gap-2">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        Agendar llamada por email
      </a>
    </div>
  </div>
</section>