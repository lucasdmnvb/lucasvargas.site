---
import { siteMeta } from '../data/portfolio';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
const isHome = currentPath === '/';
const prefix = isHome ? '' : '/';
---

<header class="sticky top-0 z-40 border-b border-line bg-canvas/85 backdrop-blur-md">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-5 py-3.5 sm:px-8">
    <a href="/" class="group flex items-center gap-3 focus:outline-none">
      <span
        class="flex h-8 w-8 items-center justify-center rounded-lg bg-ink font-mono text-xs font-semibold tracking-tight text-white transition-colors group-hover:bg-accent"
      >
        LV
      </span>
      <div class="flex flex-col">
        <span class="text-sm font-semibold tracking-tight text-ink">{siteMeta.name}</span>
        <span class="font-mono text-[11px] text-ink-soft">{siteMeta.handle}</span>
      </div>
    </a>

    <nav class="hidden items-center gap-7 md:flex" aria-label="Navegación principal">
      <a
        href={`${prefix}#casos`}
        class="text-sm font-medium text-ink-muted transition-colors hover:text-ink"
      >
        Casos
      </a>
      <a
        href={`${prefix}#laboratorio`}
        class="text-sm font-medium text-ink-muted transition-colors hover:text-ink"
      >
        Laboratorio
      </a>
      <a
        href={`${prefix}#enfoque`}
        class="text-sm font-medium text-ink-muted transition-colors hover:text-ink"
      >
        Enfoque
      </a>
      <a
        href={`${prefix}#trayectoria`}
        class="text-sm font-medium text-ink-muted transition-colors hover:text-ink"
      >
        Trayectoria
      </a>
      <a
        href={`${prefix}#contacto`}
        class="inline-flex items-center gap-1.5 rounded-full border border-line-strong bg-surface px-3.5 py-1.5 text-sm font-medium text-ink transition-all hover:border-ink hover:bg-ink hover:text-white"
      >
        Contacto
      </a>
    </nav>

    <button
      id="mobile-menu-btn"
      type="button"
      class="inline-flex items-center justify-center rounded-lg border border-line bg-surface p-2 text-ink-muted hover:text-ink md:hidden"
      aria-label="Abrir menú"
      aria-expanded="false"
    >
      <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 7h16M4 12h16M4 17h16" />
      </svg>
    </button>
  </div>

  <div id="mobile-menu" class="hidden border-t border-line bg-surface px-5 py-4 md:hidden">
    <nav class="flex flex-col gap-3" aria-label="Navegación móvil">
      <a href={`${prefix}#casos`} class="mobile-nav-link text-sm font-medium text-ink-muted hover:text-ink">
        Casos de estudio
      </a>
      <a href={`${prefix}#laboratorio`} class="mobile-nav-link text-sm font-medium text-ink-muted hover:text-ink">
        Laboratorio interactivo
      </a>
      <a href={`${prefix}#enfoque`} class="mobile-nav-link text-sm font-medium text-ink-muted hover:text-ink">
        Enfoque & Stack
      </a>
      <a href={`${prefix}#trayectoria`} class="mobile-nav-link text-sm font-medium text-ink-muted hover:text-ink">
        Trayectoria
      </a>
      <a href={`${prefix}#contacto`} class="mobile-nav-link text-sm font-semibold text-accent">
        Contacto
      </a>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      const isHidden = menu.classList.contains('hidden');
      menu.classList.toggle('hidden');
      btn.setAttribute('aria-expanded', String(isHidden));
    });
    menu.querySelectorAll('.mobile-nav-link').forEach((link) => {
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
      });
    });
  }
</script>
