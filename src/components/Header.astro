---
import { personalInfo } from '../data/cv';

const navLinks = [
  { href: '/', label: 'Inicio' },
  { href: '/experiencia', label: 'Experiencia' },
  { href: '/proyectos', label: 'Proyectos' },
  { href: '/habilidades', label: 'Habilidades' },
  { href: '/servicios-seo', label: 'Servicios SEO' },
];
---

<header class="fixed top-0 left-0 right-0 z-50 bg-white/90 backdrop-blur-md border-b border-border transition-all duration-300">
  <nav class="container mx-auto px-4 md:px-6 lg:px-8" aria-label="Navegación principal">
    <div class="flex items-center justify-between h-16 md:h-20">
      <a href="/" class="flex items-center gap-2 text-primary font-bold text-xl" aria-label="Lucas Vargas - Inicio">
        <span class="text-accent">LV</span>
        <span class="hidden sm:block">Lucas Vargas</span>
      </a>

      <div class="hidden md:flex items-center gap-8">
        {navLinks.map(link => (
          <a href={link.href} class="text-sm font-medium text-text-muted hover:text-primary transition-colors">
            {link.label}
          </a>
        ))}
        <a href="mailto:lucasvargasb@uc.cl" class="btn-primary text-sm px-5 py-2">
          Contactar
        </a>
      </div>

      <button
        class="md:hidden p-2 rounded-lg text-text hover:bg-surface transition-colors"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>

    <div id="mobile-menu" class="md:hidden hidden py-4 border-t border-border" role="navigation">
      <div class="flex flex-col gap-4">
        {navLinks.map(link => (
          <a href={link.href} class="text-base font-medium text-text-muted hover:text-primary transition-colors py-2">
            {link.label}
          </a>
        ))}
        <a href="mailto:lucasvargasb@uc.cl" class="btn-primary text-center mt-2">
          Contactar
        </a>
      </div>
    </div>
  </nav>
</header>

<script>
  const toggle = document.querySelector('[data-menu-toggle]');
  const menu = document.getElementById('mobile-menu');

  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const isOpen = menu.classList.toggle('hidden');
      toggle.setAttribute('aria-expanded', (!isOpen).toString());
      toggle.innerHTML = isOpen
        ? '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" /></svg>'
        : '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>';
    });

    menu.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
        toggle.setAttribute('aria-expanded', 'false');
        toggle.innerHTML = '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" /></svg>';
      });
    });
  }

  // Header scroll effect
  let lastScroll = 0;
  const header = document.querySelector('header');
  window.addEventListener('scroll', () => {
    const currentScroll = window.pageYOffset;
    if (currentScroll > 100) {
      header?.classList.add('shadow-md');
    } else {
      header?.classList.remove('shadow-md');
    }
    lastScroll = currentScroll;
  });
</script>