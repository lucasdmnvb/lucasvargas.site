---
import { skills, certifications, education } from '../data/cv';
---

<section id="skills" class="section" aria-labelledby="skills-title">
  <div class="container mx-auto">
    <div class="max-w-3xl mx-auto text-center mb-16">
      <span class="badge mb-4">Habilidades & Certificaciones</span>
      <h2 id="skills-title" class="section-title">Stack técnico y conocimientos</h2>
      <p class="section-subtitle">Herramientas, lenguajes y certificaciones que respaldan mi expertise</p>
    </div>

    <div class="grid lg:grid-cols-2 gap-12 mb-16">
      <div>
        <h3 class="text-lg font-semibold text-primary mb-6 flex items-center gap-2">
          <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
          </svg>
          Habilidades técnicas
        </h3>
        <div class="space-y-6">
          {Object.entries(skills).map(([category, items]) => (
            <div class="bg-white rounded-xl border border-border p-6">
              <h4 class="font-medium text-primary mb-4 flex items-center gap-2 text-sm uppercase tracking-wider text-text-muted">
                {category}
              </h4>
              <div class="flex flex-wrap gap-2">
                {items.map(skill => (
                  <span class="skill-tag" key={skill}>{skill}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>

      <div>
        <h3 class="text-lg font-semibold text-primary mb-6 flex items-center gap-2">
          <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
          Certificaciones
        </h3>
        <div class="space-y-4">
          {certifications.map(cert => (
            <a href={cert.url} target="_blank" rel="noopener noreferrer" class="card group flex items-center gap-4">
              <div class="w-12 h-12 rounded-lg bg-accent-light text-accent flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
              </div>
              <div class="flex-1 min-w-0">
                <p class="font-medium text-primary group-hover:text-accent transition-colors">{cert.name}</p>
                <p class="text-sm text-text-muted">{cert.issuer} · {cert.year}</p>
              </div>
              <svg class="w-5 h-5 text-text-muted group-hover:text-accent transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          ))}
        </div>

        <h3 class="text-lg font-semibold text-primary mb-6 mt-10 flex items-center gap-2">
          <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
          </svg>
          Educación
        </h3>
        <div class="space-y-4">
          {education.map(edu => (
            <div class="card">
              <div class="flex items-start gap-4">
                <div class="w-12 h-12 rounded-lg bg-primary/5 text-primary flex items-center justify-center flex-shrink-0">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                  </svg>
                </div>
                <div>
                  <h4 class="font-semibold text-primary">{edu.degree}</h4>
                  <p class="text-text-muted text-sm">{edu.institution}</p>
                  <p class="text-text-muted text-sm">{edu.period}</p>
                  {edu.distinction && (
                    <p class="text-accent text-sm font-medium mt-1 flex items-center gap-1">
                      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
                      {edu.distinction}
                    </p>
                  )}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>