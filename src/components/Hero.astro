---
import { personalInfo } from '../data/cv';
---

<section id="hero" class="relative min-h-screen flex items-center justify-center px-4 md:px-6 lg:px-8 pt-20 overflow-hidden" aria-labelledby="hero-title">
  <div class="absolute inset-0 bg-gradient-to-br from-primary/5 via-background to-accent/5" aria-hidden="true"></div>
  <div class="absolute inset-0 pattern-bg opacity-50" aria-hidden="true"></div>

  <div class="container mx-auto relative z-10">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <div class="animate-fade-in">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-accent-light text-accent text-sm font-medium mb-6 animate-slide-up">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-accent opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-accent"></span>
          </span>
          Disponible para proyectos freelance y consultoría SEO
        </div>

        <h1 id="hero-title" class="text-4xl md:text-5xl lg:text-6xl font-bold text-primary leading-tight mb-6 animate-slide-up" style="animation-delay: 0.1s;">
          Analista de Datos <span class="text-accent">AI-First</span> & <br class="hidden sm:block" /> Consultor SEO
        </h1>

        <p class="text-lg md:text-xl text-text-muted max-w-xl mb-8 animate-slide-up" style="animation-delay: 0.2s;">
          {personalInfo.bio}
        </p>

        <div class="flex flex-wrap items-center gap-4 mb-10 animate-slide-up" style="animation-delay: 0.3s;">
          <a href="#contact" class="btn-primary">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            Trabajemos juntos
          </a>
          <a href="#projects" class="btn-secondary">
            Ver proyectos
          </a>
        </div>

        <div class="flex flex-wrap items-center gap-8 text-sm animate-slide-up" style="animation-delay: 0.4s;">
          <div class="flex items-center gap-2 text-text-muted">
            <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>{personalInfo.location}</span>
          </div>
          <div class="flex items-center gap-2 text-text-muted">
            <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
            </svg>
            <span>+2 años experiencia</span>
          </div>
          <div class="flex items-center gap-2 text-text-muted">
            <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
            </svg>
            <span>Disponible ahora</span>
          </div>
        </div>
      </div>

      <div class="relative animate-fade-in" style="animation-delay: 0.2s;">
        <div class="relative max-w-md mx-auto">
          <div class="aspect-square relative rounded-2xl overflow-hidden bg-gradient-to-br from-primary/10 to-accent/10 border border-border">
            <img src="/avatar.jpg" alt="Lucas Vargas" class="w-full h-full object-cover" loading="eager" />
          </div>

          <div class="absolute -bottom-6 -left-6 md:-left-8 w-48 h-48 bg-accent/10 rounded-full blur-3xl" aria-hidden="true"></div>
          <div class="absolute -top-6 -right-6 md:-right-8 w-48 h-48 bg-primary/10 rounded-full blur-3xl" aria-hidden="true"></div>
        </div>
      </div>
    </div>
  </div>

  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce" aria-hidden="true">
    <svg class="w-6 h-6 text-text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
    </svg>
  </div>
</section>