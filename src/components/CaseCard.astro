---
import type { CaseStudy } from '../data/portfolio';

interface Props {
  study: CaseStudy;
}

const { study } = Astro.props;
---

<article
  class="case-card group flex flex-col justify-between rounded-2xl border border-line bg-surface p-6 transition-all duration-200 hover:-translate-y-0.5 hover:border-line-strong hover:shadow-sm sm:p-7"
  data-domains={study.domains.join(',')}
>
  <div>
    <div class="mb-5 flex flex-wrap items-center justify-between gap-2">
      <div class="flex flex-wrap items-center gap-1.5">
        <span class="font-mono text-xs font-medium text-ink-soft">{study.order}</span>
        <span class="text-line-strong">/</span>
        {
          study.domains.map((domain) => (
            <span class="rounded-full border border-line bg-surface-subtle px-2.5 py-0.5 font-mono text-[11px] font-medium text-ink-muted">
              {domain}
            </span>
          ))
        }
      </div>

      <span class="rounded-full bg-signal-soft px-2.5 py-1 font-mono text-xs font-semibold text-signal">
        {study.headlineMetric}
      </span>
    </div>

    <h3 class="mb-2.5 text-lg font-semibold leading-snug tracking-tight text-ink transition-colors group-hover:text-accent sm:text-xl">
      <a href={`/casos/${study.slug}`} class="focus:outline-none">
        {study.title}
      </a>
    </h3>

    <p class="mb-4 text-xs font-medium text-ink-soft">
      {study.organization} · {study.period}
    </p>

    <p class="mb-6 text-sm leading-relaxed text-ink-muted">
      {study.summary}
    </p>
  </div>

  <div class="border-t border-line pt-4">
    <div class="mb-4 flex flex-wrap gap-1.5">
      {
        study.stack.slice(0, 5).map((item) => (
          <span class="rounded-md bg-surface-subtle px-2 py-0.5 font-mono text-[11px] text-ink-muted">
            {item}
          </span>
        ))
      }
      {
        study.stack.length > 5 && (
          <span class="rounded-md bg-surface-subtle px-2 py-0.5 font-mono text-[11px] text-ink-soft">
            +{study.stack.length - 5}
          </span>
        )
      }
    </div>

    <a
      href={`/casos/${study.slug}`}
      class="inline-flex items-center gap-1.5 text-sm font-semibold text-ink transition-colors group-hover:text-accent"
    >
      Explorar caso completo
      <svg
        class="h-4 w-4 transition-transform group-hover:translate-x-0.5"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
      </svg>
    </a>
  </div>
</article>
