---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import { projects } from '../data/cv';
import { skills } from '../data/cv';
import { seoServices } from '../data/cv';
import Contact from '../components/Contact.astro';
import { siteConfig } from '../data/cv';
---

<Layout
  title={`${siteConfig.name} | ${siteConfig.title}`}
  description={siteConfig.description}
  canonicalURL="/"
>
  <Header />
  <main class="flex-1">
    <Hero />
    <About />

    <section id="projects" class="section bg-surface" aria-labelledby="projects-title">
      <div class="container mx-auto">
        <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-12">
          <div>
            <span class="badge mb-4">Proyectos destacados</span>
            <h2 id="projects-title" class="section-title">Proyectos con impacto real</h2>
          </div>
          <a href="/proyectos" class="btn-secondary self-start">
            Ver todos los proyectos
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {projects.filter(p => p.featured).map((project, index) => (
            <article class="card group" style="animation-delay: {index * 100}ms">
              <div class="flex items-start gap-3 mb-4">
                <div class="w-10 h-10 rounded-lg bg-accent-light text-accent flex items-center justify-center flex-shrink-0">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                  </svg>
                </div>
                <span class="badge self-start mt-1">Destacado</span>
              </div>
              <h3 class="text-lg font-semibold text-primary mb-3 group-hover:text-accent transition-colors">{project.name}</h3>
              <p class="text-text-muted text-sm mb-5 line-clamp-3">{project.description}</p>

              <div class="flex flex-wrap gap-2 mb-5" aria-label="Tecnologías">
                {project.tech.slice(0, 4).map(tech => (
                  <span class="px-2.5 py-1 rounded-md bg-primary/5 text-primary text-xs font-medium border border-primary/10" key={tech}>{tech}</span>
                ))}
                {project.tech.length > 4 && (
                  <span class="px-2.5 py-1 rounded-md bg-surface text-text-muted text-xs font-medium border border-border">+{project.tech.length - 4} más</span>
                )}
              </div>

              <div class="flex items-center gap-3 pt-4 border-t border-border">
                <a href={project.github} class="btn-ghost text-sm px-3 py-1.5" target="_blank" rel="noopener noreferrer" aria-label="Ver código en GitHub">
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
                  Código
                </a>
                <a href={project.link} class="btn-ghost text-sm px-3 py-1.5" target="_blank" rel="noopener noreferrer" aria-label="Ver demo">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
                  Demo
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="skills" class="section" aria-labelledby="skills-title">
      <div class="container mx-auto">
        <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-12">
          <div>
            <span class="badge mb-4">Habilidades principales</span>
            <h2 id="skills-title" class="section-title">Stack técnico</h2>
          </div>
          <a href="/habilidades" class="btn-secondary self-start">
            Ver todas las habilidades
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>

        <div class="grid md:grid-cols-3 gap-6 max-w-5xl mx-auto">
          {Object.entries(skills).slice(0, 3).map(([category, items], index) => (
            <div class="card p-6" style="animation-delay: {index * 100}ms">
              <h3 class="font-semibold text-primary mb-4 flex items-center gap-2 text-sm uppercase tracking-wider text-text-muted">{category}</h3>
              <div class="flex flex-wrap gap-2">
                {items.slice(0, 6).map(skill => (
                  <span class="skill-tag" key={skill}>{skill}</span>
                ))}
                {items.length > 6 && (
                  <span class="px-3 py-1.5 rounded-lg bg-surface text-text-muted text-sm font-medium border border-border">+{items.length - 6} más</span>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="services" class="section bg-surface" aria-labelledby="services-title">
      <div class="container mx-auto">
        <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-12">
          <div>
            <span class="badge mb-4">Servicios SEO</span>
            <h2 id="services-title" class="section-title">Consultoría especializada</h2>
          </div>
          <a href="/servicios-seo" class="btn-secondary self-start">
            Ver todos los servicios
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>

        <div class="grid md:grid-cols-3 gap-6">
          {seoServices.slice(0, 3).map((service, index) => (
            <article class="card group" style="animation-delay: {index * 100}ms">
              <h3 class="text-lg font-semibold text-primary mb-3">{service.title}</h3>
              <p class="text-text-muted text-sm mb-4 line-clamp-2">{service.description}</p>
              <div class="text-lg font-bold text-accent mb-4">{service.price}</div>
              <ul class="space-y-2 mb-5" role="list">
                {service.features.slice(0, 3).map(feature => (
                  <li class="flex items-start gap-2 text-sm text-text">
                    <svg class="w-4 h-4 text-accent flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    <span>{feature}</span>
                  </li>
                ))}
                {service.features.length > 3 && (
                  <li class="flex items-start gap-2 text-sm text-text-muted">
                    <svg class="w-4 h-4 text-accent flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                    </svg>
                    <span>+{service.features.length - 3} más</span>
                  </li>
                )}
              </ul>
              <a href="/servicios-seo" class="btn-secondary w-full text-center group-hover:bg-primary group-hover:text-white group-hover:border-primary">
                Ver detalles
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <Contact />
  </main>
  <Footer />
</Layout>