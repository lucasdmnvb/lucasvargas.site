---
import Layout from '../layouts/Layout.astro';
import InteractiveSandbox from '../components/InteractiveSandbox.astro';
import {
  siteMeta,
  nowParagraphs,
  craftProjects,
  ideaNotes,
  conversationStarters,
} from '../data/portfolio';
---

<Layout title={`${siteMeta.name} — Datos, Producto & Experimentos`} description={siteMeta.heroThesis}>
  <div class="relative z-10 mx-auto min-h-screen max-w-6xl px-6 py-12 md:px-12 md:py-20 lg:px-16 lg:py-0">
    <div class="lg:flex lg:justify-between lg:gap-12">
      <!-- Sticky Left Sidebar (brittanychiang.com inspired) -->
      <header class="lg:sticky lg:top-0 lg:flex lg:max-h-screen lg:w-[42%] lg:flex-col lg:justify-between lg:py-20">
        <div>
          <div class="mb-5 inline-flex items-center gap-2.5 rounded-full border border-white/10 bg-slate-900/70 px-3 py-1 font-mono text-[11px] text-slate-300 backdrop-blur-sm">
            <span class="h-1.5 w-1.5 rounded-full bg-teal-300 shadow-[0_0_8px_#5eead4]"></span>
            <span>{siteMeta.location}</span>
            <span class="text-slate-600">·</span>
            <span id="santiago-clock" class="text-teal-300">--:-- CLT</span>
          </div>

          <h1 class="text-4xl font-bold tracking-tight text-slate-100 sm:text-5xl">
            <a href="/" class="transition-colors hover:text-teal-300">{siteMeta.name}</a>
          </h1>

          <p class="mt-3 font-serif text-2xl italic tracking-wide text-teal-300/95 sm:text-[26px]">
            Datos, producto & sistemas con IA
          </p>

          <p class="mt-4 max-w-sm text-sm leading-relaxed text-slate-400">
            {siteMeta.heroThesis}
          </p>

          <!-- Dynamic Scrollspy Navigation -->
          <nav class="mt-12 hidden lg:block" aria-label="Navegación de secciones">
            <ul class="w-max space-y-3.5">
              <li>
                <a href="#hoy" class="nav-link is-active group flex items-center gap-4" data-section="hoy">
                  <span class="nav-indicator"></span>
                  <span class="nav-text font-mono text-xs font-semibold uppercase tracking-widest text-slate-400 transition-colors group-hover:text-slate-100">
                    01 · Hoy
                  </span>
                </a>
              </li>
              <li>
                <a href="#proyectos" class="nav-link group flex items-center gap-4" data-section="proyectos">
                  <span class="nav-indicator"></span>
                  <span class="nav-text font-mono text-xs font-semibold uppercase tracking-widest text-slate-400 transition-colors group-hover:text-slate-100">
                    02 · Proyectos
                  </span>
                </a>
              </li>
              <li>
                <a href="#playground" class="nav-link group flex items-center gap-4" data-section="playground">
                  <span class="nav-indicator"></span>
                  <span class="nav-text font-mono text-xs font-semibold uppercase tracking-widest text-slate-400 transition-colors group-hover:text-slate-100">
                    03 · Playground
                  </span>
                </a>
              </li>
              <li>
                <a href="#notas" class="nav-link group flex items-center gap-4" data-section="notas">
                  <span class="nav-indicator"></span>
                  <span class="nav-text font-mono text-xs font-semibold uppercase tracking-widest text-slate-400 transition-colors group-hover:text-slate-100">
                    04 · Notas & Ideas
                  </span>
                </a>
              </li>
              <li>
                <a href="#hablemos" class="nav-link group flex items-center gap-4" data-section="hablemos">
                  <span class="nav-indicator"></span>
                  <span class="nav-text font-mono text-xs font-semibold uppercase tracking-widest text-slate-400 transition-colors group-hover:text-slate-100">
                    05 · Hablemos
                  </span>
                </a>
              </li>
            </ul>
          </nav>
        </div>

        <!-- Bottom Contact & Links -->
        <div class="mt-8 flex flex-wrap items-center gap-5 lg:mt-0">
          <a
            href={siteMeta.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-sm font-medium text-slate-400 transition-colors hover:text-teal-300"
          >
            LinkedIn <span class="text-xs">↗</span>
          </a>
          <a
            href={`mailto:${siteMeta.email}`}
            class="inline-flex items-center gap-1.5 text-sm font-medium text-slate-400 transition-colors hover:text-teal-300"
          >
            Correo <span class="text-xs">↗</span>
          </a>
          <a
            href="#playground"
            class="rounded-full border border-teal-400/25 bg-teal-400/10 px-3 py-1 font-mono text-[11px] font-medium text-teal-300 transition-all hover:bg-teal-400/20 active:scale-[0.97]"
          >
            Probar demos ↓
          </a>
        </div>
      </header>

      <!-- Scrollable Right Content -->
      <main class="pt-14 lg:w-[58%] lg:py-20">
        <!-- 01: Hoy -->
        <section id="hoy" class="scroll-mt-20 pb-20">
          <div class="mb-5 flex items-center gap-3 lg:hidden">
            <span class="font-mono text-xs font-semibold uppercase tracking-widest text-teal-300">01 · Hoy</span>
            <span class="h-px flex-1 bg-white/10"></span>
          </div>

          <div class="space-y-4 text-[15px] leading-relaxed text-slate-300/90">
            {nowParagraphs.map((p) => <p>{p}</p>)}
          </div>

          <div class="mt-7 rounded-2xl border border-white/10 bg-slate-900/45 p-5">
            <span class="font-mono text-[11px] uppercase tracking-widest text-slate-400">
              Temas en los que estoy metido ahora
            </span>
            <div class="mt-3 flex flex-wrap gap-2">
              {[
                'Retención & Cohortes',
                'GEO / Posicionamiento en LLMs',
                'Python + Claude Code',
                'Atribución Paid / SEO',
                'n8n & APIs',
                'Product Discovery',
              ].map((topic) => (
                <span class="rounded-full border border-teal-400/20 bg-teal-400/10 px-3 py-1 font-mono text-xs text-teal-300">
                  {topic}
                </span>
              ))}
            </div>
          </div>
        </section>

        <!-- 02: Proyectos (Group-hover dimming inspired by Brittany Chiang) -->
        <section id="proyectos" class="scroll-mt-20 pb-20">
          <div class="mb-6 flex items-baseline justify-between gap-4">
            <div>
              <span class="font-mono text-xs font-semibold uppercase tracking-widest text-teal-300">
                02 · Proyectos & Portafolio
              </span>
              <h2 class="mt-1.5 text-xl font-bold tracking-tight text-slate-100">
                Cosas que construí, medí o lancé
              </h2>
            </div>
            <span class="hidden font-mono text-[11px] text-slate-500 sm:inline">
              Hover para enfocar
            </span>
          </div>

          <div class="group/list space-y-4">
            {
              craftProjects.map((project) => (
                <article class="group relative rounded-2xl border border-white/5 bg-slate-900/25 p-5 transition-all duration-300 hover:!opacity-100 hover:border-white/15 hover:bg-slate-800/45 hover:shadow-[inset_0_1px_0_0_rgba(148,163,184,0.12)] group-hover/list:opacity-45 sm:p-6">
                  <div class="mb-2.5 flex flex-wrap items-center justify-between gap-2">
                    <span class="font-mono text-[11px] uppercase tracking-wider text-slate-400">
                      {project.index} · {project.category}
                    </span>
                    <span class="rounded-full bg-teal-400/10 px-2.5 py-0.5 font-mono text-[11px] font-medium text-teal-300">
                      {project.metricBadge}
                    </span>
                  </div>

                  <h3 class="text-lg font-semibold tracking-tight text-slate-100 transition-colors group-hover:text-teal-300">
                    <a href={`/casos/${project.slug}`} class="inline-flex items-baseline gap-1.5">
                      <span>{project.title}</span>
                      <span class="inline-block text-sm transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5">
                        ↗
                      </span>
                    </a>
                  </h3>

                  <p class="mt-2 font-serif text-lg italic text-slate-300">“{project.hook}”</p>

                  <p class="mt-2 text-sm leading-relaxed text-slate-400">{project.story}</p>

                  <div class="mt-4 flex flex-wrap items-center justify-between gap-3 pt-2">
                    <div class="flex flex-wrap gap-1.5">
                      {project.tags.map((tag) => (
                        <span class="rounded-full bg-white/5 px-2.5 py-0.5 font-mono text-[11px] text-slate-300">
                          {tag}
                        </span>
                      ))}
                    </div>

                    <div class="flex items-center gap-3 text-xs font-medium">
                      {project.sandboxId && (
                        <a
                          href="#playground"
                          data-jump-sandbox={project.sandboxId}
                          class="jump-sandbox font-mono text-sky-300 transition-colors hover:text-sky-200"
                        >
                          Probar demo ↓
                        </a>
                      )}
                      <a
                        href={`/casos/${project.slug}`}
                        class="font-mono text-teal-300 transition-colors hover:text-teal-200"
                      >
                        Detalle →
                      </a>
                    </div>
                  </div>
                </article>
              ))
            }
          </div>
        </section>

        <!-- 03: Interactive Playground -->
        <section id="playground" class="scroll-mt-20 pb-20">
          <div class="mb-5">
            <span class="font-mono text-xs font-semibold uppercase tracking-widest text-teal-300">
              03 · Laboratorio Interactivo
            </span>
            <h2 class="mt-1.5 text-xl font-bold tracking-tight text-slate-100">
              En vez de solo contarlo, pruébalo aquí
            </h2>
          </div>

          <InteractiveSandbox />
        </section>

        <!-- 04: Notas & Ideas para dialogar -->
        <section id="notas" class="scroll-mt-20 pb-20">
          <div class="mb-6">
            <span class="font-mono text-xs font-semibold uppercase tracking-widest text-teal-300">
              04 · Notas & Puntos de vista
            </span>
            <h2 class="mt-1.5 text-xl font-bold tracking-tight text-slate-100">
              Ideas cortas para abrir conversación
            </h2>
            <p class="mt-1.5 text-sm text-slate-400">
              Haz clic en cualquiera para leer la nota completa o llevar el tema directo al cuadro de diálogo.
            </p>
          </div>

          <div class="space-y-3">
            {
              ideaNotes.map((note) => (
                <div class="note-card rounded-2xl border border-white/10 bg-slate-900/40 transition-colors hover:border-white/20">
                  <button
                    type="button"
                    class="note-toggle flex w-full items-start justify-between gap-4 p-5 text-left"
                    aria-expanded="false"
                  >
                    <div>
                      <div class="flex items-center gap-2 font-mono text-[11px] text-teal-300">
                        <span>{note.tag}</span>
                        <span class="text-slate-600">·</span>
                        <span class="text-slate-400">{note.readTime}</span>
                      </div>
                      <h3 class="mt-1.5 text-base font-semibold text-slate-100">{note.title}</h3>
                      <p class="mt-1 text-sm text-slate-400">{note.teaser}</p>
                    </div>
                    <span class="note-plus mt-1 flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-white/10 font-mono text-sm text-slate-300 transition-transform">
                      +
                    </span>
                  </button>

                  <div class="note-body hidden border-t border-white/10 px-5 pb-5 pt-4">
                    <div class="space-y-3 text-sm leading-relaxed text-slate-300">
                      {note.body.map((para) => <p>{para}</p>)}
                    </div>
                    <div class="mt-4 flex justify-end">
                      <a
                        href="#hablemos"
                        data-topic-text={note.promptTopic}
                        class="debate-btn inline-flex items-center gap-1.5 rounded-full border border-teal-400/30 bg-teal-400/10 px-3.5 py-1.5 font-mono text-xs font-medium text-teal-300 transition-all hover:bg-teal-400/20 active:scale-[0.97]"
                      >
                        ¿Opinas distinto? Conversemos de esto ↓
                      </a>
                    </div>
                  </div>
                </div>
              ))
            }
          </div>
        </section>

        <!-- 05: Hablemos (Interactive Conversation Composer) -->
        <section id="hablemos" class="scroll-mt-20 pb-16">
          <div class="rounded-2xl border border-white/10 bg-gradient-to-br from-slate-900/90 via-slate-900/60 to-teal-950/30 p-6 shadow-[inset_0_1px_0_0_rgba(148,163,184,0.12)] sm:p-8">
            <span class="font-mono text-xs font-semibold uppercase tracking-widest text-teal-300">
              05 · Hablemos
            </span>
            <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-100">
              Elige un tema y partimos la conversación
            </h2>
            <p class="mt-2 text-sm text-slate-400">
              Si quieres comentar un experimento, debatir sobre métricas/GEO o mostrarme un problema entretenido de datos o producto:
            </p>

            <div class="mt-5 flex flex-wrap gap-2">
              {
                conversationStarters.map((starter, idx) => (
                  <button
                    type="button"
                    data-starter-id={starter.id}
                    data-subject={starter.subject}
                    data-draft={starter.draft}
                    class={`starter-pill rounded-full border px-3.5 py-1.5 font-mono text-xs transition-all active:scale-[0.97] ${
                      idx === 0
                        ? 'border-teal-400/40 bg-teal-400/15 text-teal-200'
                        : 'border-white/10 bg-slate-950/60 text-slate-300 hover:border-white/25'
                    }`}
                  >
                    {starter.label}
                  </button>
                ))
              }
            </div>

            <div class="mt-4 rounded-xl border border-white/10 bg-slate-950/80 p-4">
              <label for="chat-draft" class="mb-2 block font-mono text-[10px] uppercase tracking-wider text-slate-500">
                Mensaje editable listo para enviar o copiar
              </label>
              <textarea
                id="chat-draft"
                rows="3"
                class="w-full resize-none bg-transparent text-sm leading-relaxed text-slate-200 focus:outline-none"
              >{conversationStarters[0].draft}</textarea>

              <div class="mt-3 flex flex-wrap items-center justify-between gap-3 border-t border-white/10 pt-3">
                <div class="flex flex-wrap items-center gap-2.5">
                  <a
                    id="send-mailto"
                    href={`mailto:${siteMeta.email}?subject=${encodeURIComponent(conversationStarters[0].subject)}&body=${encodeURIComponent(conversationStarters[0].draft)}`}
                    class="inline-flex items-center gap-2 rounded-xl bg-teal-300 px-4 py-2 text-xs font-bold text-slate-950 transition-all hover:bg-teal-200 active:scale-[0.97]"
                  >
                    Abrir en correo ↗
                  </a>
                  <button
                    id="copy-draft-btn"
                    type="button"
                    class="inline-flex items-center gap-1.5 rounded-xl border border-white/15 bg-white/5 px-3.5 py-2 font-mono text-xs font-medium text-slate-200 transition-all hover:bg-white/10 active:scale-[0.97]"
                  >
                    Copiar texto
                  </button>
                </div>

                <a
                  href={siteMeta.linkedin}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="font-mono text-xs text-slate-400 transition-colors hover:text-teal-300"
                >
                  O escribir por LinkedIn ↗
                </a>
              </div>
            </div>
          </div>

          <!-- Minimal Footer -->
          <footer class="mt-12 flex flex-wrap items-center justify-between gap-4 border-t border-white/10 pt-6 font-mono text-[11px] text-slate-500">
            <span>{siteMeta.name} · {siteMeta.handle} · Construido en Astro</span>
            <a
              href={siteMeta.cvUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-slate-400 underline decoration-white/20 underline-offset-4 transition-colors hover:text-teal-300"
            >
              ¿Buscas el CV formal? Abrir Google Doc ↗
            </a>
          </footer>
        </section>
      </main>
    </div>
  </div>
</Layout>

<script>
  // 1. Live Santiago Clock
  const clockEl = document.getElementById('santiago-clock');
  const updateClock = () => {
    if (!clockEl) return;
    try {
      const time = new Intl.DateTimeFormat('es-CL', {
        timeZone: 'America/Santiago',
        hour: '2-digit',
        minute: '2-digit',
        hour12: false,
      }).format(new Date());
      clockEl.textContent = `${time} CLT`;
    } catch {
      clockEl.textContent = 'Santiago';
    }
  };
  updateClock();
  setInterval(updateClock, 30_000);

  // 2. Scrollspy for left sticky navigation
  const navLinks = document.querySelectorAll<HTMLAnchorElement>('.nav-link');
  const sections = ['hoy', 'proyectos', 'playground', 'notas', 'hablemos']
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => Boolean(el));

  const setActiveNav = (id: string) => {
    navLinks.forEach((link) => {
      link.classList.toggle('is-active', link.dataset.section === id);
    });
  };

  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            setActiveNav(entry.target.id);
          }
        });
      },
      { rootMargin: '-25% 0px -60% 0px', threshold: 0.05 }
    );
    sections.forEach((sec) => observer.observe(sec));
  }

  // 3. Jump from project card to specific sandbox tab
  document.querySelectorAll<HTMLAnchorElement>('.jump-sandbox').forEach((link) => {
    link.addEventListener('click', () => {
      const target = link.dataset.jumpSandbox;
      if (target) {
        window.dispatchEvent(new CustomEvent('select-sandbox', { detail: target }));
      }
    });
  });

  // 4. Expandable Notes & Ideas
  document.querySelectorAll<HTMLElement>('.note-card').forEach((card) => {
    const btn = card.querySelector<HTMLButtonElement>('.note-toggle');
    const body = card.querySelector<HTMLElement>('.note-body');
    const plus = card.querySelector<HTMLElement>('.note-plus');
    if (!btn || !body || !plus) return;

    btn.addEventListener('click', () => {
      const isHidden = body.classList.contains('hidden');
      body.classList.toggle('hidden');
      btn.setAttribute('aria-expanded', String(isHidden));
      plus.textContent = isHidden ? '−' : '+';
    });
  });

  // 5. Interactive Conversation Composer
  const emailAddress = 'lucasdamian.vb@gmail.com';
  const draftEl = document.getElementById('chat-draft') as HTMLTextAreaElement | null;
  const mailtoEl = document.getElementById('send-mailto') as HTMLAnchorElement | null;
  const copyBtn = document.getElementById('copy-draft-btn') as HTMLButtonElement | null;
  const starterPills = document.querySelectorAll<HTMLButtonElement>('.starter-pill');

  let currentSubject = 'Conversar sobre GEO / visibilidad en LLMs';

  const syncMailto = () => {
    if (!draftEl || !mailtoEl) return;
    mailtoEl.href = `mailto:${emailAddress}?subject=${encodeURIComponent(currentSubject)}&body=${encodeURIComponent(draftEl.value)}`;
  };

  starterPills.forEach((pill) => {
    pill.addEventListener('click', () => {
      starterPills.forEach((p) => {
        const active = p === pill;
        p.classList.toggle('border-teal-400/40', active);
        p.classList.toggle('bg-teal-400/15', active);
        p.classList.toggle('text-teal-200', active);
        p.classList.toggle('border-white/10', !active);
        p.classList.toggle('bg-slate-950/60', !active);
        p.classList.toggle('text-slate-300', !active);
      });
      currentSubject = pill.dataset.subject || currentSubject;
      if (draftEl && pill.dataset.draft) {
        draftEl.value = pill.dataset.draft;
      }
      syncMailto();
    });
  });

  draftEl?.addEventListener('input', syncMailto);

  document.querySelectorAll<HTMLAnchorElement>('.debate-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const topic = btn.dataset.topicText || '';
      if (draftEl && topic) {
        currentSubject = topic;
        draftEl.value = `Hola Lucas, leí tu nota y me gustaría ${topic.toLowerCase()}.`;
        syncMailto();
      }
    });
  });

  copyBtn?.addEventListener('click', async () => {
    if (!draftEl) return;
    try {
      await navigator.clipboard.writeText(draftEl.value);
      const original = copyBtn.textContent;
      copyBtn.textContent = '¡Copiado!';
      setTimeout(() => {
        copyBtn.textContent = original || 'Copiar texto';
      }, 1600);
    } catch {
      draftEl.select();
    }
  });
</script>
