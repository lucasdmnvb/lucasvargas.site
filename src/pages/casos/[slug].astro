---
import Layout from '../../layouts/Layout.astro';
import { craftProjects, siteMeta } from '../../data/portfolio';

export function getStaticPaths() {
  return craftProjects.map((project, index) => ({
    params: { slug: project.slug },
    props: {
      project,
      prevProject: index > 0 ? craftProjects[index - 1] : null,
      nextProject: index < craftProjects.length - 1 ? craftProjects[index + 1] : null,
    },
  }));
}

const { project, prevProject, nextProject } = Astro.props;
---

<Layout title={`${project.title} — ${siteMeta.name}`} description={project.hook}>
  <div class="relative z-10 mx-auto max-w-4xl px-6 py-12 sm:px-10 sm:py-20">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <a
        href="/#proyectos"
        class="inline-flex items-center gap-2 font-mono text-xs font-medium text-slate-400 transition-colors hover:text-teal-300"
      >
        ← Volver a proyectos
      </a>
      {
        project.sandboxId && (
          <a
            href="/#playground"
            class="rounded-full border border-teal-400/25 bg-teal-400/10 px-3 py-1 font-mono text-[11px] font-medium text-teal-300 transition-colors hover:bg-teal-400/20"
          >
            Probar simulador interactivo ↗
          </a>
        )
      }
    </div>

    <header class="mt-8 border-b border-white/10 pb-8">
      <div class="mb-4 flex flex-wrap items-center gap-2.5">
        <span class="font-mono text-xs text-teal-300">{project.index} · {project.category}</span>
        <span class="text-slate-600">/</span>
        <span class="rounded-full bg-teal-400/10 px-3 py-0.5 font-mono text-xs font-medium text-teal-300">
          {project.metricBadge}
        </span>
      </div>

      <h1 class="text-3xl font-bold leading-tight tracking-tight text-slate-100 sm:text-4xl">
        {project.title}
      </h1>
      <p class="mt-3 font-serif text-2xl italic text-slate-300">
        “{project.hook}”
      </p>
    </header>

    <!-- Architecture Flow -->
    <section class="my-10">
      <h2 class="mb-4 font-mono text-[11px] font-semibold uppercase tracking-widest text-slate-400">
        Arquitectura del sistema
      </h2>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {
          project.flow.map((node, idx) => (
            <div class="rounded-xl border border-white/10 bg-slate-900/50 p-4">
              <span class="font-mono text-[11px] font-semibold text-teal-300">0{idx + 1}</span>
              <h3 class="mt-1 text-sm font-semibold text-slate-100">{node.step}</h3>
              <p class="mt-1 text-xs leading-relaxed text-slate-400">{node.detail}</p>
            </div>
          ))
        }
      </div>
    </section>

    <div class="space-y-6">
      <section class="rounded-2xl border border-white/10 bg-slate-900/45 p-6 sm:p-8">
        <h2 class="text-base font-bold text-slate-100">1. El problema detrás del pedido</h2>
        <p class="mt-3 text-sm leading-relaxed text-slate-300 sm:text-base">{project.context}</p>
        <p class="mt-3 text-sm leading-relaxed text-slate-400 sm:text-base">{project.challenge}</p>
      </section>

      <section class="rounded-2xl border border-white/10 bg-slate-900/45 p-6 sm:p-8">
        <h2 class="text-base font-bold text-slate-100">2. Cómo lo abordé</h2>
        <ul class="mt-4 space-y-3 text-sm leading-relaxed text-slate-300 sm:text-base">
          {
            project.approach.map((item) => (
              <li class="flex items-start gap-3">
                <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-teal-300" />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="rounded-2xl border border-white/10 bg-slate-900/45 p-6 sm:p-8">
        <h2 class="text-base font-bold text-slate-100">3. Trade-offs & decisiones</h2>
        <ul class="mt-4 space-y-3 text-sm leading-relaxed text-slate-300 sm:text-base">
          {
            project.tradeoffs.map((item) => (
              <li class="flex items-start gap-3">
                <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-sky-300" />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="rounded-2xl border border-teal-400/25 bg-teal-400/10 p-6 sm:p-8">
        <h2 class="text-base font-bold text-teal-200">4. Resultado</h2>
        <p class="mt-2 text-sm leading-relaxed text-slate-100 sm:text-base">{project.outcome}</p>
        <div class="mt-5 flex flex-wrap gap-1.5">
          {
            project.tags.map((tag) => (
              <span class="rounded-full border border-white/10 bg-slate-950/60 px-3 py-0.5 font-mono text-xs text-slate-200">
                {tag}
              </span>
            ))
          }
        </div>
      </section>

      <section class="rounded-2xl border border-white/10 bg-slate-900/60 p-6 sm:p-8">
        <div class="mb-2 flex flex-wrap items-center justify-between gap-2">
          <h2 class="text-sm font-semibold text-slate-100">{project.snippet.title}</h2>
          <span class="rounded-md bg-white/5 px-2 py-0.5 font-mono text-[11px] uppercase text-teal-300">
            {project.snippet.language}
          </span>
        </div>
        <p class="mb-4 text-xs text-slate-400">{project.snippet.note}</p>
        <pre class="overflow-x-auto rounded-xl border border-white/10 bg-black/60 p-4 font-mono text-xs leading-relaxed text-teal-200"><code>{project.snippet.code}</code></pre>
      </section>
    </div>

    <nav class="mt-12 grid gap-4 border-t border-white/10 pt-8 sm:grid-cols-2" aria-label="Otros proyectos">
      {
        prevProject ? (
          <a
            href={`/casos/${prevProject.slug}`}
            class="rounded-xl border border-white/10 bg-slate-900/40 p-4 transition-colors hover:border-teal-400/35"
          >
            <span class="font-mono text-[11px] text-slate-400">← Proyecto anterior</span>
            <p class="mt-1 text-sm font-semibold text-slate-100">{prevProject.title}</p>
          </a>
        ) : (
          <div />
        )
      }
      {
        nextProject && (
          <a
            href={`/casos/${nextProject.slug}`}
            class="rounded-xl border border-white/10 bg-slate-900/40 p-4 text-right transition-colors hover:border-teal-400/35"
          >
            <span class="font-mono text-[11px] text-slate-400">Siguiente proyecto →</span>
            <p class="mt-1 text-sm font-semibold text-slate-100">{nextProject.title}</p>
          </a>
        )
      }
    </nav>
  </div>
</Layout>
