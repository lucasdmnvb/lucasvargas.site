---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { caseStudies, siteMeta } from '../../data/portfolio';

export function getStaticPaths() {
  return caseStudies.map((study, index) => ({
    params: { slug: study.slug },
    props: {
      study,
      prevStudy: index > 0 ? caseStudies[index - 1] : null,
      nextStudy: index < caseStudies.length - 1 ? caseStudies[index + 1] : null,
    },
  }));
}

const { study, prevStudy, nextStudy } = Astro.props;
---

<Layout
  title={`${study.title} — ${siteMeta.name}`}
  description={study.summary}
>
  <Header currentPath={`/casos/${study.slug}`} />

  <main class="flex-1">
    <article class="mx-auto max-w-4xl px-5 py-12 sm:px-8 sm:py-16">
      <a
        href="/#casos"
        class="inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-ink-muted transition-colors hover:text-ink"
      >
        ← Volver a casos de estudio
      </a>

      <header class="mt-6 border-b border-line pb-8">
        <div class="mb-4 flex flex-wrap items-center gap-2">
          <span class="font-mono text-xs font-medium text-ink-soft">Caso {study.order}</span>
          <span class="text-line-strong">/</span>
          {
            study.domains.map((domain) => (
              <span class="rounded-full border border-line bg-surface-subtle px-2.5 py-0.5 font-mono text-[11px] font-medium text-ink-muted">
                {domain}
              </span>
            ))
          }
          <span class="ml-auto rounded-full bg-signal-soft px-3 py-1 font-mono text-xs font-semibold text-signal">
            {study.headlineMetric} · {study.headlineLabel}
          </span>
        </div>

        <h1 class="text-2xl font-bold leading-tight tracking-tight text-ink sm:text-4xl">
          {study.title}
        </h1>
        <p class="mt-3 text-base leading-relaxed text-ink-muted sm:text-lg">
          {study.subtitle}
        </p>

        <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-2 text-xs font-medium text-ink-soft">
          <span>
            <strong class="text-ink">Contexto:</strong> {study.organization}
          </span>
          <span>
            <strong class="text-ink">Período:</strong> {study.period}
          </span>
        </div>
      </header>

      <!-- Architecture Flow -->
      <section class="my-10">
        <h2 class="mb-4 font-mono text-xs font-semibold uppercase tracking-wider text-ink-soft">
          Flujo de trabajo y arquitectura
        </h2>
        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
          {
            study.flow.map((node, idx) => (
              <div class="rounded-xl border border-line bg-surface p-4">
                <span class="font-mono text-[11px] font-semibold text-accent">0{idx + 1}</span>
                <h3 class="mt-1 text-sm font-semibold text-ink">{node.step}</h3>
                <p class="mt-1 text-xs leading-relaxed text-ink-muted">{node.detail}</p>
              </div>
            ))
          }
        </div>
      </section>

      <!-- Case Narrative -->
      <div class="space-y-8">
        <section class="rounded-2xl border border-line bg-surface p-6 sm:p-8">
          <h2 class="text-lg font-bold text-ink">1. Contexto y problema de negocio</h2>
          <p class="mt-3 text-sm leading-relaxed text-ink-muted sm:text-base">{study.context}</p>
          <p class="mt-3 text-sm leading-relaxed text-ink-muted sm:text-base">{study.challenge}</p>
        </section>

        <section class="rounded-2xl border border-line bg-surface p-6 sm:p-8">
          <h2 class="text-lg font-bold text-ink">2. Enfoque analítico y ejecución</h2>
          <ul class="mt-4 space-y-3 text-sm leading-relaxed text-ink-muted sm:text-base">
            {
              study.approach.map((item) => (
                <li class="flex items-start gap-3">
                  <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent" />
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
        </section>

        <section class="rounded-2xl border border-line bg-surface p-6 sm:p-8">
          <h2 class="text-lg font-bold text-ink">3. Decisiones y trade-offs</h2>
          <ul class="mt-4 space-y-3 text-sm leading-relaxed text-ink-muted sm:text-base">
            {
              study.tradeoffs.map((item) => (
                <li class="flex items-start gap-3">
                  <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-ink-soft" />
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
        </section>

        <section class="rounded-2xl border border-signal/30 bg-signal-soft/40 p-6 sm:p-8">
          <h2 class="text-lg font-bold text-signal">4. Impacto medible</h2>
          <p class="mt-2 text-sm leading-relaxed text-ink sm:text-base">{study.outcome}</p>
          <div class="mt-5 flex flex-wrap gap-1.5">
            {
              study.stack.map((tech) => (
                <span class="rounded-md border border-line bg-surface px-2.5 py-1 font-mono text-xs text-ink">
                  {tech}
                </span>
              ))
            }
          </div>
        </section>

        <section class="rounded-2xl border border-line bg-surface p-6 sm:p-8">
          <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
            <h2 class="text-sm font-bold text-ink">{study.snippet.title}</h2>
            <span class="rounded-md bg-surface-subtle px-2 py-0.5 font-mono text-[11px] uppercase text-ink-muted">
              {study.snippet.language}
            </span>
          </div>
          <p class="mb-4 text-xs text-ink-soft">{study.snippet.note}</p>
          <pre class="overflow-x-auto rounded-xl bg-ink p-4 font-mono text-xs leading-relaxed text-neutral-100"><code>{study.snippet.code}</code></pre>
        </section>
      </div>

      <!-- Prev / Next Navigation -->
      <nav
        class="mt-12 grid gap-4 border-t border-line pt-8 sm:grid-cols-2"
        aria-label="Navegación entre casos"
      >
        {
          prevStudy ? (
            <a
              href={`/casos/${prevStudy.slug}`}
              class="rounded-xl border border-line bg-surface p-4 transition-colors hover:border-ink"
            >
              <span class="font-mono text-[11px] text-ink-soft">← Caso anterior</span>
              <p class="mt-1 text-sm font-semibold text-ink">{prevStudy.title}</p>
            </a>
          ) : (
            <div />
          )
        }
        {
          nextStudy && (
            <a
              href={`/casos/${nextStudy.slug}`}
              class="rounded-xl border border-line bg-surface p-4 text-right transition-colors hover:border-ink"
            >
              <span class="font-mono text-[11px] text-ink-soft">Siguiente caso →</span>
              <p class="mt-1 text-sm font-semibold text-ink">{nextStudy.title}</p>
            </a>
          )
        }
      </nav>
    </article>
  </main>

  <Footer />
</Layout>
