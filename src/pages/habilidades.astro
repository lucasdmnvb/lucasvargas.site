---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { skills, certifications, education } from '../data/cv';
import { siteConfig } from '../data/cv';
import { categoryIcons } from '../data/icons';
---

<Layout
  title={`Habilidades | ${siteConfig.name}`}
  description="Stack técnico: Python, SQL, BigQuery, Looker Studio, GA4, n8n, Claude/GPT, Screaming Frog, Ahrefs, Semrush. Certificaciones en Data Analytics with AI, Google Digital Marketing, English B2. Educación: Licenciatura UC con distinción."
  canonicalURL="/habilidades"
>
  <Header />
  <main class="flex-1">
    <section class="relative min-h-[50vh] flex items-center justify-center px-4 md:px-6 lg:px-8 pt-20 bg-gradient-to-br from-primary/5 via-background to-accent/5" aria-labelledby="skills-hero-title">
      <div class="container mx-auto text-center">
        <span class="badge mb-4 inline-block">Habilidades & Certificaciones</span>
        <h1 id="skills-hero-title" class="text-4xl md:text-5xl lg:text-6xl font-bold text-primary leading-tight mb-6">
          Stack técnico y <span class="text-accent">conocimientos</span>
        </h1>
        <p class="text-lg md:text-xl text-text-muted max-w-3xl mx-auto">
          Herramientas, lenguajes y certificaciones que respaldan mi expertise en Data, IA y SEO.
        </p>
      </div>
    </section>

    <section class="section" aria-labelledby="tech-skills-title">
      <div class="container mx-auto">
        <div class="max-w-3xl mx-auto text-center mb-16">
          <h2 id="tech-skills-title" class="section-title">Habilidades técnicas</h2>
          <p class="section-subtitle">Organizadas por área de especialización</p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto">
          {Object.entries(skills).map(([category, items], catIndex) => (
            <div class="card p-8" style="animation-delay: {catIndex * 100}ms">
              <div class="flex items-center gap-3 mb-6">
                <div class="w-12 h-12 rounded-xl bg-accent-light text-accent flex items-center justify-center" set:html={categoryIcons[category] || ''} />
                <h3 class="text-lg font-semibold text-primary">{category}</h3>
              </div>
              <div class="flex flex-wrap gap-2.5">
                {items.map(skill => (
                  <span class="skill-tag" key={skill}>{skill}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section bg-surface" aria-labelledby="certs-title">
      <div class="container mx-auto">
        <div class="max-w-3xl mx-auto text-center mb-16">
          <h2 id="certs-title" class="section-title">Certificaciones</h2>
          <p class="section-subtitle">Validaciones oficiales de competencias técnicas</p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-5xl mx-auto">
          {certifications.map((cert, index) => (
            <a href={cert.url} target="_blank" rel="noopener noreferrer" class="card group flex items-start gap-4 p-6" style="animation-delay: {index * 100}ms">
              <div class="w-14 h-14 rounded-xl bg-accent-light text-accent flex items-center justify-center flex-shrink-0">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
              </div>
              <div class="flex-1 min-w-0">
                <p class="font-medium text-primary group-hover:text-accent transition-colors">{cert.name}</p>
                <p class="text-sm text-text-muted mt-1">{cert.issuer}</p>
                <p class="text-xs text-text-muted mt-1">{cert.year}</p>
              </div>
              <svg class="w-5 h-5 text-text-muted group-hover:text-accent transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="edu-title">
      <div class="container mx-auto">
        <div class="max-w-3xl mx-auto text-center mb-16">
          <h2 id="edu-title" class="section-title">Educación</h2>
          <p class="section-subtitle">Formación académica y distinciones</p>
        </div>

        <div class="max-w-2xl mx-auto">
          {education.map((edu, index) => (
            <div class="card relative overflow-hidden" style="animation-delay: {index * 100}ms">
              <div class="absolute left-0 top-0 bottom-0 w-1 bg-gradient-to-b from-accent to-primary" aria-hidden="true"></div>
              <div class="flex items-start gap-6">
                <div class="w-16 h-16 rounded-xl bg-primary/5 text-primary flex items-center justify-center flex-shrink-0">
                  <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                  </svg>
                </div>
                <div class="flex-1">
                  <h3 class="text-xl font-semibold text-primary mb-1">{edu.degree}</h3>
                  <p class="text-text-muted mb-1">{edu.institution}</p>
                  <p class="text-text-muted text-sm mb-3">{edu.period}</p>
                  {edu.distinction && (
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-50 text-amber-700 text-sm font-medium border border-amber-200">
                      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
                      {edu.distinction}
                    </span>
                  )}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>